{
  "name": "workbench",
  "version": "1.0.3-beta.2",
  "description": "Workbench \u2014 a Cursor-style cockpit for running Claude Code and Codex CLI side by side, on a real tmux backend.",
  "main": "./out/main/index.js",
  "author": "Keegan Arko",
  "contributors": [
    "Keegan Arko (https://github.com/keeganarko)",
    "hiteshsv1 (https://github.com/hiteshsv1)"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "node scripts/build.mjs build",
    "rebuild": "electron-rebuild -f -w node-pty",
    "icon": "node scripts/make-icon.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import ./test/ts-resolve.mjs --test \"test/*.test.mjs\"",
    "verify": "npm run typecheck && npm run build && npm test",
    "doctor:wslg": "node scripts/check-wslg.mjs",
    "package": "node scripts/build.mjs package --mac --dir",
    "dist": "node scripts/build.mjs package --mac",
    "package:wslg": "node scripts/build.mjs package --linux dir",
    "dist:wslg": "node scripts/build.mjs package --linux AppImage",
    "package:win": "node scripts/build.mjs package --win --dir",
    "dist:win": "node scripts/build.mjs package --win nsis",
    "dev:app": "node scripts/dev-app.mjs",
    "link:app": "node scripts/link-app.mjs && npm run build",
    "unlink:app": "node scripts/link-app.mjs --undo",
    "icon:ico": "node scripts/make-icon.mjs --ico"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.keeganarko.workbench",
    "productName": "Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "bin/**/*",
      "resources/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns"
    },
    "linux": {
      "category": "Development",
      "icon": "resources/icon.png",
      "target": [
        "AppImage"
      ],
      "artifactName": "Workbench-WSLg-${version}-${arch}.${ext}"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico",
      "artifactName": "Workbench-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Workbench"
    }
  },
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  }
}
